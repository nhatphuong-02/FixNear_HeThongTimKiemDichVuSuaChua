<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================================== -->
    <!-- FIXNEAR - CARD STYLES                -->
    <!-- ===================================== -->

    <!-- Card nội dung chung -->
    <style name="FixNearCard">
        <item name="cardBackgroundColor">@color/card_cream</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeColor">@color/border_card</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Card thống kê -->
    <style name="FixNearStatCard" parent="FixNearCard">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Card trạng thái trống / lỗi -->
    <style name="FixNearEmptyCard" parent="FixNearCard">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
    </style>


    <!-- ===================================== -->
    <!-- FIXNEAR - TEXT STYLES               -->
    <!-- ===================================== -->

    <!-- Tiêu đề Section trên nền tối -->
    <style name="FixNearSectionTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary_dark</item>
    </style>

    <!-- Tiêu đề bên trong Card kem -->
    <style name="FixNearCardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary_card</item>
    </style>

    <!-- Nội dung mô tả bên trong Card -->
    <style name="FixNearCardSubtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary_card</item>
    </style>

    <!-- Trạng thái / thông báo trong Card -->
    <style name="FixNearEmptyTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary_card</item>
    </style>

    <style name="FixNearEmptyDescription">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary_card</item>
    </style>


    <!-- ===================================== -->
    <!-- FIXNEAR - BUTTON STYLES             -->
    <!-- ===================================== -->

    <!-- Nội dung chữ nút chính -->
    <style name="FixNearButtonText">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary_card</item>
    </style>


    <!-- ===================================== -->
    <!-- FIXNEAR - STAT STYLES               -->
    <!-- ===================================== -->

    <!-- Tên trạng thái -->
    <style name="FixNearStatLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary_card</item>
    </style>

    <!-- Số liệu thống kê -->
    <style name="FixNearStatValue">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary_card</item>
    </style>


    <!-- ===================================== -->
    <!-- FIXNEAR - BOTTOM NAVIGATION          -->
    <!-- ===================================== -->

    <style name="HomeNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Icon Navigation -->
    <style name="HomeNavIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_secondary_dark</item>
    </style>

    <!-- Label Navigation -->
    <style name="HomeNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary_dark</item>
    </style>

</resources>