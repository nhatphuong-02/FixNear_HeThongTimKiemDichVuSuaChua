<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp"
    android:background="#151210" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btnBack" android:layout_width="48dp"
            android:layout_height="48dp" android:gravity="center" android:text="‹"
            android:textColor="#FFF4EA" android:textSize="30sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Đánh giá cửa hàng"
            android:gravity="center" android:textColor="#D8975B"
            android:textStyle="bold" android:textSize="19sp"/>
        <TextView android:id="@+id/btnRefresh" android:layout_width="48dp"
            android:layout_height="48dp" android:gravity="center" android:text="↻"
            android:textColor="#FFF4EA" android:textSize="27sp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvShopName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:textColor="#FFF8F1" android:textSize="22sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvState" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp" android:text="Đang tải đánh giá..."
        android:textColor="#C7B9AF" android:textSize="13sp"/>
    <ProgressBar android:id="@+id/progress" android:layout_width="match_parent"
        android:layout_height="3dp" android:indeterminateTint="#D8975B"
        android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvReviews"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="14dp"
        android:clipToPadding="false"/>
    <Button android:id="@+id/btnLoadMore" android:layout_width="match_parent"
        android:layout_height="50dp" android:text="Xem thêm đánh giá" android:textAllCaps="false"
        android:textColor="#FFF4EA" android:backgroundTint="#5C4030"
        android:visibility="gone"/>
</LinearLayout>
