<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="34sp"
            android:textColor="@color/accent_gold"
            android:background="@drawable/bg_register_input"
            android:backgroundTint="@color/input_background"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Công việc được giao"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TECHNICIAN"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/accent_gold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"
            android:background="@drawable/bg_header_role" />
    </LinearLayout>

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- GREETING -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xin chào kỹ thuật viên 👋"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_dark" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Theo dõi và quản lý các công việc sửa chữa của bạn."
                android:textSize="14sp"
                android:textColor="@color/text_secondary_dark"
                android:lineSpacingExtra="3dp" />

            <!-- STATISTICS TITLE -->
            <TextView
                style="@style/FixNearSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="Tổng quan công việc" />

            <!-- STATISTICS CARDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- PENDING -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/card_cream"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvCountPending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_pending" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Chờ nhận"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary_card" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ACTIVE -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    app:cardBackgroundColor="@color/card_cream"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvCountActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_processing" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Đang làm"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary_card" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- COMPLETED -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    app:cardBackgroundColor="@color/card_cream"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/border_card"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvCountDone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_completed" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Hoàn thành"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary_card" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- JOB LIST TITLE -->
            <TextView
                style="@style/FixNearSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="14dp"
                android:text="Danh sách công việc" />

            <!-- FILTERS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Tất cả"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/button_primary_text"
                        android:background="@drawable/bg_register_input"
                        android:backgroundTint="@color/accent_gold" />

                    <TextView
                        android:id="@+id/tvFilterPending"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Chờ nhận"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/tab_unselected"
                        android:background="@drawable/bg_register_input"
                        android:backgroundTint="@color/input_background" />

                    <TextView
                        android:id="@+id/tvFilterActive"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Đang làm"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/tab_unselected"
                        android:background="@drawable/bg_register_input"
                        android:backgroundTint="@color/input_background" />

                    <TextView
                        android:id="@+id/tvFilterDone"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Hoàn thành"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/tab_unselected"
                        android:background="@drawable/bg_register_input"
                        android:backgroundTint="@color/input_background" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- LOADING STATE -->
            <LinearLayout
                android:id="@+id/layoutLoadingAssignments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressAssignments"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent_gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Đang tải công việc..."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary_dark" />
            </LinearLayout>

            <!-- ERROR STATE -->
            <LinearLayout
                android:id="@+id/layoutErrorAssignments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/bg_register_card"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Không thể tải công việc"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_card" />

                <TextView
                    android:id="@+id/tvErrorAssignments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Đã xảy ra lỗi. Vui lòng thử lại."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary_card" />

                <Button
                    android:id="@+id/btnRetryAssignments"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Thử lại"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="@color/button_primary_text"
                    android:backgroundTint="@color/accent_gold" />
            </LinearLayout>

            <!-- EMPTY STATE -->
            <TextView
                android:id="@+id/tvEmptyAssignments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="Chưa có công việc"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_card"
                android:background="@drawable/bg_register_card"
                android:visibility="gone" />

            <!-- SUCCESS STATE: ASSIGNMENT LIST -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAssignments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingBottom="20dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
