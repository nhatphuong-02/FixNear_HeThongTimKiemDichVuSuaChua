<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#151210"
    android:fitsSystemWindows="true" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btnBack" android:layout_width="46dp" android:layout_height="48dp" android:text="‹" android:textSize="32sp" android:gravity="center" android:textColor="#FFF8F1" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Hóa đơn &amp; thanh toán" android:gravity="center" android:textColor="#D8975B" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/btnRefresh" android:layout_width="46dp" android:layout_height="48dp" android:text="↻" android:textSize="28sp" android:gravity="center" android:textColor="#FFF8F1" />
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminateTint="#D8975B" android:visibility="gone" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="20dp">
            <TextView android:id="@+id/tvState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đang tải hóa đơn" android:textColor="#D8975B" android:textSize="14sp" android:layout_marginBottom="14dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/fixnear_section_card" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHI TIẾT HÓA ĐƠN" android:textColor="#D8975B" android:textStyle="bold" android:textSize="15sp" />
                <TextView android:id="@+id/tvInvoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Chưa có dữ liệu" android:textColor="#FFF8F1" android:textSize="14sp" android:lineSpacingExtra="6dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="PHƯƠNG THỨC THANH TOÁN" android:textColor="#D8975B" android:textStyle="bold" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Chọn phương thức để tạo yêu cầu thanh toán. Hệ thống/Shop sẽ xác nhận giao dịch sau đó." android:textColor="#C7B9AF" android:textSize="13sp" />
            <Button android:id="@+id/btnCash" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:backgroundTint="#D8975B" android:textColor="#1D150F" android:textStyle="bold" android:textAllCaps="false" android:text="Thanh toán tiền mặt" />
            <Button android:id="@+id/btnBank" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:backgroundTint="#604231" android:textColor="#FFF8F1" android:textAllCaps="false" android:text="Tạo yêu cầu chuyển khoản" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="TRẠNG THÁI THANH TOÁN" android:textColor="#D8975B" android:textStyle="bold" android:textSize="15sp" />
            <TextView android:id="@+id/tvPayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Chưa có dữ liệu" android:textColor="#FFF8F1" android:textSize="14sp" android:lineSpacingExtra="5dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
