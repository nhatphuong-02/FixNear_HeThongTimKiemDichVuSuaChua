<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#151210"
    android:fitsSystemWindows="true">

    <!-- KHU VỰC NỘI DUNG CÁC TAB -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB TRANG CHỦ -->
        <ScrollView
            android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- LOGO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FixNear"
                        android:textColor="#D8975B"
                        android:textSize="29sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUẢN LÝ"
                        android:textColor="#D8975B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:padding="10dp"/>
                </LinearLayout>

                <!-- LỜI CHÀO -->
                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Xin chào, Quản lý!"
                    android:textColor="#FFF4EA"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:maxLines="2"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tổng quan cửa hàng của bạn"
                    android:textColor="#C7B9AF"
                    android:textSize="14sp"/>

                <!-- THẺ SHOP -->
                <LinearLayout
                    android:id="@+id/cardShop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/fixnear_manager_cream_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="62dp"
                        android:layout_height="70dp"
                        android:gravity="center"
                        android:text="⌂"
                        android:textSize="43sp"
                        android:textColor="#A5652B"
                        android:contentDescription="Cửa hàng"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cửa hàng của bạn"
                            android:textColor="#66442F"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvShopName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Đang tải cửa hàng..."
                            android:textColor="#251A14"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:maxLines="2"/>

                        <TextView
                            android:id="@+id/tvShopStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Đang kết nối backend"
                            android:textColor="#996536"
                            android:textSize="12sp"/>

                    </LinearLayout>
                </LinearLayout>

                <!-- TIÊU ĐỀ THỐNG KÊ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="27dp"
                    android:layout_marginBottom="13dp"
                    android:text="Tổng quan"
                    android:textColor="#FFF4EA"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <!-- 3 THẺ THỐNG KÊ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardNewRequests"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/fixnear_manager_cream_card"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▤"
                            android:textColor="#A5652B"
                            android:textSize="28sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="5dp"
                            android:text="Yêu cầu mới"
                            android:textColor="#38251B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvNewRequests"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="—"
                            android:textColor="#A5652B"
                            android:textSize="26sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardProcessing"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/fixnear_manager_cream_card"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚙"
                            android:textColor="#A5652B"
                            android:textSize="28sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="5dp"
                            android:text="Đang xử lý"
                            android:textColor="#38251B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvProcessing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="—"
                            android:textColor="#A5652B"
                            android:textSize="26sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardToday"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/fixnear_manager_cream_card"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▦"
                            android:textColor="#A5652B"
                            android:textSize="28sp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="5dp"
                            android:text="Lịch hôm nay"
                            android:textColor="#38251B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvToday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="—"
                            android:textColor="#A5652B"
                            android:textSize="26sp"
                            android:textStyle="bold"/>

                    </LinearLayout>
                </LinearLayout>

                <!-- HOẠT ĐỘNG GẦN ĐÂY -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hoạt động gần đây"
                        android:textColor="#FFF4EA"
                        android:textSize="19sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/btnSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="Xem tất cả ›"
                        android:textColor="#D8975B"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/fixnear_manager_cream_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Chưa có dữ liệu hoạt động"
                        android:textColor="#38251B"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Danh sách yêu cầu sửa chữa sẽ được đồng bộ từ backend ở bước tiếp theo."
                        android:textColor="#8B7160"
                        android:textSize="13sp"
                        android:textAlignment="center"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- TAB LỊCH PHÂN CÔNG -->
        <LinearLayout
            android:id="@+id/pageSchedule"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="22dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Lịch phân công"
                android:textColor="#FFF4EA"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Quản lý công việc và lịch của kỹ thuật viên"
                android:textColor="#B9A79B"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/fixnear_manager_cream_card"
                android:padding="24dp"
                android:text="Chưa tải lịch phân công.\n\nTab này sẽ kết nối API lịch sửa chữa và phân công của Manager."
                android:textColor="#66442F"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"/>

        </LinearLayout>

        <!-- TAB TÌM KIẾM -->
        <LinearLayout
            android:id="@+id/pageSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="22dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Tìm kiếm"
                android:textColor="#FFF4EA"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Tìm yêu cầu và thông tin cửa hàng"
                android:textColor="#B9A79B"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/fixnear_auth_input"
                android:hint="Nhập mã yêu cầu hoặc từ khóa..."
                android:inputType="text"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFF4EA"
                android:textColorHint="#B9A79B"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvSearchHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Chức năng tra cứu sẽ được kết nối với API tìm kiếm phù hợp."
                android:textColor="#B9A79B"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- TAB HỒ SƠ -->
        <LinearLayout
            android:id="@+id/pageProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="22dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Hồ sơ quản lý"
                android:textColor="#FFF4EA"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/fixnear_manager_cream_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:text="TÀI KHOẢN"
                    android:textColor="#996536"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Quản lý"
                    android:textColor="#251A14"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvProfileShop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Cửa hàng: Đang tải..."
                    android:textColor="#66442F"
                    android:textSize="14sp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/btnOpenShopProfile"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/fixnear_manager_cream_card"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="⌂   Xem hồ sơ cửa hàng     ›"
                android:textColor="#66442F"
                android:textStyle="bold"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/fixnear_role_card"
                android:gravity="center"
                android:text="Đăng xuất"
                android:textColor="#D8975B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </FrameLayout>

    <!-- THANH ĐIỀU HƯỚNG CỐ ĐỊNH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:orientation="horizontal"
        android:background="@drawable/fixnear_manager_bottom_nav"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="8dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#D8975B"
                android:textSize="27sp"/>

            <TextView
                android:id="@+id/labelHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Trang chủ"
                android:textColor="#D8975B"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textColor="#C7B9AF"
                android:textSize="26sp"/>

            <TextView
                android:id="@+id/labelSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Lịch phân công"
                android:textColor="#C7B9AF"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textColor="#C7B9AF"
                android:textSize="29sp"/>

            <TextView
                android:id="@+id/labelSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tìm kiếm"
                android:textColor="#C7B9AF"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/iconProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♙"
                android:textColor="#C7B9AF"
                android:textSize="27sp"/>

            <TextView
                android:id="@+id/labelProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Hồ sơ"
                android:textColor="#C7B9AF"
                android:textSize="11sp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
