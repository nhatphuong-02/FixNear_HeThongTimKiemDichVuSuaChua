<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151210"
    android:fitsSystemWindows="true">

    <!-- NHÓM NỘI DUNG CĂN GIỮA -->
    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- LOGO -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogo"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="66dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFF8F1">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo_fixnear"
                android:scaleType="centerCrop"
                android:contentDescription="Logo FixNear"/>
        </androidx.cardview.widget.CardView>

        <!-- TÊN THƯƠNG HIỆU -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIX"
                android:textColor="#D8975B"
                android:textSize="36sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvNear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEAR"
                android:textColor="#FFF4EA"
                android:textSize="36sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- ĐƯỜNG NHẤN -->
        <View
            android:layout_width="52dp"
            android:layout_height="3dp"
            android:layout_marginTop="18dp"
            android:background="#D8975B"/>

        <!-- SLOGAN -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Tìm dịch vụ gần bạn"
            android:textColor="#E0A16D"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <!-- MÔ TẢ -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="Sửa chữa thiết bị và tiện ích tại nhà&#10;nhanh chóng, thuận tiện và tin cậy"
            android:textColor="#C7B9AF"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- FOOTER -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:text="FIXNEAR  •  YOUR REPAIR COMPANION"
        android:textColor="#796B62"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
