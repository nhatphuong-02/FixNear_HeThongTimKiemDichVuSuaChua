<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151210"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FixNear"
            android:textColor="#D8975B"
            android:textSize="23sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- TIÊU ĐỀ -->
    <TextView
        android:id="@+id/tvPageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="18dp"
        android:text="Danh mục &amp; Dịch vụ"
        android:textColor="#FFF4EA"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <!-- TÌM KIẾM -->
    <EditText
        android:id="@+id/edtSearchService"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/fixnear_auth_input"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawableTint="#D8975B"
        android:drawablePadding="10dp"
        android:hint="Tìm dịch vụ sửa chữa..."
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:singleLine="true"
        android:textColor="#FFF4EA"
        android:textColorHint="#B9A79B"
        android:textSize="14sp"/>

    <!-- LABEL DANH MỤC -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="24dp"
        android:text="Chọn danh mục"
        android:textColor="#FFF4EA"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <!-- COMBOBOX DANH MỤC -->
    <Spinner
        android:id="@+id/spCategory"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/fixnear_auth_input"
        android:dropDownWidth="match_parent"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:spinnerMode="dropdown"/>

    <TextView
        android:id="@+id/tvCategoryState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:text="Đang tải danh mục..."
        android:textColor="#B9A79B"
        android:textSize="12sp"/>

    <!-- TIÊU ĐỀ DỊCH VỤ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="25dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvServiceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tất cả dịch vụ"
            android:textColor="#FFF4EA"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnShowAllServices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Xem tất cả"
            android:textColor="#D8975B"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvServiceState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:text="Đang tải dịch vụ..."
        android:textColor="#B9A79B"
        android:textSize="13sp"/>

    <!-- DANH SÁCH DỊCH VỤ: RECYCLERVIEW DỌC -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvServices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:paddingBottom="18dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        tools:listitem="@layout/item_customer_service"/>

    <!-- BOTTOM NAVIGATION CUSTOMER -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#302925"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <!-- TRANG CHỦ -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#C7B9AF"
                android:textSize="23sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Trang chủ"
                android:textColor="#C7B9AF"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- TÌM KIẾM: TAB ĐANG CHỌN -->
        <LinearLayout
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textColor="#D8975B"
                android:textSize="23sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tìm kiếm"
                android:textColor="#D8975B"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- TIN NHẮN -->
        <LinearLayout
            android:id="@+id/navMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉"
                android:textColor="#C7B9AF"
                android:textSize="21sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tin nhắn"
                android:textColor="#C7B9AF"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- TÀI KHOẢN -->
        <LinearLayout
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#C7B9AF"
                android:textSize="21sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tài khoản"
                android:textColor="#C7B9AF"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
