<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#151210"
    android:fitsSystemWindows="true"
    tools:context=".ui.home.HomeActivity">

  <!-- NỘI DUNG TRANG CHỦ -->
  <ScrollView
      android:id="@+id/homeScroll"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true"
      android:clipToPadding="false"
      android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

      <!-- HEADER -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:orientation="horizontal"
          android:gravity="center_vertical">

        <!-- LOGO FIXNEAR: ĐÃ BỎ Ô CHỮ F -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="FixNear"
              android:textColor="#D8975B"
              android:textSize="24sp"
              android:textStyle="bold"/>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:text="Dịch vụ sửa chữa gần bạn"
              android:textColor="#B9A79B"
              android:textSize="12sp"/>

        </LinearLayout>

        <!-- NÚT THÔNG BÁO VÀ HUY HIỆU CHƯA ĐỌC -->
        <FrameLayout
            android:id="@+id/btnNotifications"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Xem thông báo"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/fixnear_role_card"
                android:src="@drawable/fixnear_ic_bell"
                android:tint="#D8975B"
                android:padding="12dp"
                android:contentDescription="Biểu tượng thông báo" />
            <TextView
                android:id="@+id/tvNotificationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="@drawable/fixnear_pill_gold"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:gravity="center"
                android:minWidth="19dp"
                android:minHeight="19dp"
                android:text="0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#291B13"
                android:visibility="gone" />
        </FrameLayout>

        <!-- AVATAR -->
        <ImageView
            android:id="@+id/tvProfileAvatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/fixnear_role_card"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="#D8975B"
            android:padding="12dp"
            android:contentDescription="Hồ sơ cá nhân"
            android:clickable="true"
            android:focusable="true"/>

      </LinearLayout>

      <!-- LỜI CHÀO -->
      <TextView
          android:id="@+id/tvGreeting"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:text="Xin chào!"
          android:textColor="#FFF4EA"
          android:textSize="22sp"
          android:textStyle="bold"/>

      <!-- ĐỊA CHỈ TỪ BACKEND -->
      <TextView
          android:id="@+id/tvAddress"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="7dp"
          android:text="Đang tải khu vực của bạn..."
          android:textColor="#B9A79B"
          android:textSize="13sp"
          android:maxLines="2"
          android:ellipsize="end"/>

      <!-- THANH TÌM KIẾM -->
      <EditText
          android:id="@+id/edtSearchService"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:layout_marginTop="22dp"
          android:background="@drawable/fixnear_auth_input"
          android:drawableStart="@android:drawable/ic_menu_search"
          android:drawableTint="#D8975B"
          android:drawablePadding="12dp"
          android:hint="Bạn cần tìm dịch vụ gì?"
          android:imeOptions="actionSearch"
          android:inputType="text"
          android:paddingStart="16dp"
          android:paddingEnd="16dp"
          android:singleLine="true"
          android:textColor="#FFF4EA"
          android:textColorHint="#B9A79B"
          android:textSize="14sp"
          android:focusable="false"
          android:clickable="true"/>

      <!-- BANNER -->
      <LinearLayout
          android:id="@+id/layoutHomeBanner"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="22dp"
          android:background="@drawable/fixnear_customer_banner"
          android:orientation="vertical"
          android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sửa chữa dễ dàng hơn"
            android:textColor="#FFF4EA"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tìm kiếm và kết nối với dịch vụ sửa chữa phù hợp."
            android:textColor="#E9DED4"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"/>

        <!-- NÚT ĐÃ SỬA KHÔNG BỊ CẮT CHỮ -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnExploreServices"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="17dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/fixnear_customer_cream"
            android:backgroundTint="@null"
            android:text="Khám phá dịch vụ"
            android:textAllCaps="false"
            android:singleLine="true"
            android:textColor="#66442F"
            android:textSize="13sp"
            android:textStyle="bold"/>

      </LinearLayout>

      <!-- NÚT QUÉT TÌM TIỆM -->
      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btnFindNearby"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_marginTop="14dp"
          android:minWidth="0dp"
          android:minHeight="0dp"
          android:paddingStart="12dp"
          android:paddingEnd="12dp"
          android:background="@drawable/fixnear_register_button"
          android:backgroundTint="@null"
          android:text="⌖  Tìm tiệm gần bạn theo dịch vụ"
          android:textAllCaps="false"
          android:singleLine="true"
          android:textColor="#FFFFFF"
          android:textSize="14sp"
          android:textStyle="bold"/>

      <!-- CUSTOMER: YÊU CẦU VÀ LỊCH SỬA CHỮA -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:orientation="horizontal">

          <androidx.appcompat.widget.AppCompatButton
              android:id="@+id/btnMyRequests"
              android:layout_width="0dp"
              android:layout_height="54dp"
              android:layout_weight="1"
              android:background="@drawable/fixnear_customer_cream"
              android:backgroundTint="@null"
              android:text="Yêu cầu của tôi"
              android:textAllCaps="false"
              android:textColor="#66442F"
              android:textSize="13sp"
              android:textStyle="bold" />

          <Space android:layout_width="10dp" android:layout_height="1dp" />

          <androidx.appcompat.widget.AppCompatButton
              android:id="@+id/btnUpcomingSchedules"
              android:layout_width="0dp"
              android:layout_height="54dp"
              android:layout_weight="1"
              android:background="@drawable/fixnear_customer_cream"
              android:backgroundTint="@null"
              android:text="Lịch sắp tới"
              android:textAllCaps="false"
              android:textColor="#66442F"
              android:textSize="13sp"
              android:textStyle="bold" />
      </LinearLayout>

      <!-- DANH MỤC DỊCH VỤ -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="26dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Danh mục dịch vụ"
            android:textColor="#FFF4EA"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnAllCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Xem tất cả ›"
            android:textColor="#D8975B"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"/>
      </LinearLayout>

      <TextView
          android:id="@+id/tvCategoryState"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="Đang tải danh mục..."
          android:textColor="#B9A79B"
          android:textSize="13sp"/>

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rvCategories"
          android:layout_width="match_parent"
          android:layout_height="174dp"
          android:layout_marginTop="12dp"
          android:clipToPadding="false"
          android:nestedScrollingEnabled="false"
          android:overScrollMode="never"
          tools:listitem="@layout/item_home_category_banner"/>
      <!-- FOOTER -->
      <TextView
          android:id="@+id/tvSupport"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="26dp"
          android:gravity="center"
          android:text="FixNear • Kết nối dịch vụ sửa chữa"
          android:textColor="#987B68"
          android:textSize="12sp"/>

    </LinearLayout>
  </ScrollView>

  <!-- BOTTOM NAVIGATION CỐ ĐỊNH -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="68dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:background="#302925"
      android:elevation="8dp">

    <!-- TRANG CHỦ -->
    <LinearLayout
        android:id="@+id/navHome"
        style="@style/HomeNavItem"
        android:orientation="vertical"
        android:gravity="center">

      <TextView
          style="@style/HomeNavIcon"
          android:text="⌂"
          android:textColor="#D8975B"/>

      <TextView
          style="@style/HomeNavLabel"
          android:text="Trang chủ"
          android:textColor="#D8975B"/>
    </LinearLayout>

    <!-- TÌM KIẾM -->
    <LinearLayout
        android:id="@+id/navSearch"
        style="@style/HomeNavItem"
        android:orientation="vertical"
        android:gravity="center">

      <TextView
          style="@style/HomeNavIcon"
          android:text="⌕"/>

      <TextView
          style="@style/HomeNavLabel"
          android:text="Tìm kiếm"/>
    </LinearLayout>

    <!-- TIN NHẮN -->
    <LinearLayout
        android:id="@+id/navMessages"
        style="@style/HomeNavItem"
        android:orientation="vertical"
        android:gravity="center">

      <TextView
          style="@style/HomeNavIcon"
          android:text="✉"/>

      <TextView
          style="@style/HomeNavLabel"
          android:text="Tin nhắn"/>
    </LinearLayout>

    <!-- TÀI KHOẢN -->
    <LinearLayout
        android:id="@+id/navAccount"
        style="@style/HomeNavItem"
        android:orientation="vertical"
        android:gravity="center">

      <TextView
          style="@style/HomeNavIcon"
          android:text="●"/>

      <TextView
          style="@style/HomeNavLabel"
          android:text="Tài khoản"/>
    </LinearLayout>

  </LinearLayout>

</LinearLayout>
