<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- THANH TIEU DE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBackRepair"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/input_text"
            android:textSize="32sp"
            android:contentDescription="Quay lại"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Tiến độ sửa chữa"
            android:textColor="@color/input_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutRepairContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TRANG THAI CONG VIEC -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/card_cream"
                app:cardCornerRadius="20dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvRepairRequestId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mã yêu cầu: --"
                        android:textColor="@color/text_primary_card"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRepairStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Trạng thái: Chưa tải"
                        android:textColor="@color/accent_brown"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BAT DAU SUA CHUA -->
            <Button
                android:id="@+id/btnStartRepair"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Bắt đầu sửa chữa"
                android:textColor="@color/button_primary_text"
                android:backgroundTint="@color/accent_gold"
                android:enabled="false" />

            <ProgressBar
                android:id="@+id/progressRepair"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/accent_gold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvRepairMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/input_hint"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnRetryRepairStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Thử tải lại"
                android:textColor="@color/button_primary_text"
                android:backgroundTint="@color/accent_gold"
                android:visibility="gone" />
            <!-- GHI NHAN LINH KIEN -->
            <com.google.android.material.card.MaterialCardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/card_cream"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Linh kiện sử dụng"
                        android:textColor="@color/text_primary_card"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Chọn linh kiện đã sử dụng trong quá trình sửa chữa"
                        android:textColor="@color/text_secondary_card"
                        android:textSize="13sp" />

                    <Spinner
                        android:id="@+id/spinnerRepairPart"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:enabled="false" />

                    <EditText
                        android:id="@+id/edtRepairPartQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:padding="12dp"
                        android:hint="Số lượng sử dụng"
                        android:inputType="numberDecimal"
                        android:backgroundTint="@color/accent_gold"
                        android:textColor="@color/text_primary_card"
                        android:textColorHint="@color/text_secondary_card" />

                    <EditText
                        android:id="@+id/edtRepairPartNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp"
                        android:layout_marginTop="12dp"
                        android:padding="12dp"
                        android:gravity="top"
                        android:hint="Ghi chú linh kiện (không bắt buộc)"
                        android:inputType="textMultiLine"
                        android:maxLength="500"
                        android:backgroundTint="@color/accent_gold"
                        android:textColor="@color/text_primary_card"
                        android:textColorHint="@color/text_secondary_card" />

                    <Button
                        android:id="@+id/btnRecordRepairPart"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Ghi nhận linh kiện"
                        android:textColor="@color/button_primary_text"
                        android:backgroundTint="@color/accent_gold"
                        android:enabled="false" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- HOAN TAT SUA CHUA -->
            <com.google.android.material.card.MaterialCardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/card_cream"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hoàn tất sửa chữa"
                        android:textColor="@color/text_primary_card"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Xác nhận sau khi đã thực hiện đầy đủ công việc sửa chữa và ghi nhận linh kiện sử dụng."
                        android:textColor="@color/text_secondary_card"
                        android:textSize="14sp" />

                    <!-- KET QUA SUA CHUA -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Kết quả sửa chữa *"
                        android:textColor="@color/text_primary_card"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtRepairResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="90dp"
                        android:gravity="top"
                        android:padding="12dp"
                        android:hint="Nhập kết quả sửa chữa"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="1000"
                        android:backgroundTint="@color/accent_gold"
                        android:textColor="@color/text_primary_card"
                        android:textColorHint="@color/text_secondary_card" />

                    <!-- CONG VIEC DA THUC HIEN -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Công việc đã thực hiện"
                        android:textColor="@color/text_primary_card"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtRepairWorkDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="90dp"
                        android:gravity="top"
                        android:padding="12dp"
                        android:hint="Mô tả những việc đã làm"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="2000"
                        android:backgroundTint="@color/accent_gold"
                        android:textColor="@color/text_primary_card"
                        android:textColorHint="@color/text_secondary_card" />

                    <!-- KHUYEN NGHI -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Khuyến nghị cho khách hàng"
                        android:textColor="@color/text_primary_card"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtRepairRecommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="90dp"
                        android:gravity="top"
                        android:padding="12dp"
                        android:hint="Nhập khuyến nghị nếu có"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="1000"
                        android:backgroundTint="@color/accent_gold"
                        android:textColor="@color/text_primary_card"
                        android:textColorHint="@color/text_secondary_card" />

                    <Button
                        android:id="@+id/btnCompleteRepair"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Xác nhận hoàn tất"
                        android:textColor="@color/button_primary_text"
                        android:backgroundTint="@color/accent_gold"
                        android:enabled="false" />

                    <TextView
                        android:id="@+id/tvCompleteRepairMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Chỉ có thể hoàn tất khi công việc đang sửa chữa"
                        android:textColor="@color/text_secondary_card"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
