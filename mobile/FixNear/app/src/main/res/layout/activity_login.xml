<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Logo tròn đồng bộ -->
        <androidx.cardview.widget.CardView
            android:layout_width="116dp"
            android:layout_height="116dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="58dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Logo FixNear"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_fixnear" />

        </androidx.cardview.widget.CardView>

        <!-- Tên thương hiệu -->
        <LinearLayout
            android:id="@+id/layoutBrandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="FIX"
                android:textColor="#2563EB"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEAR"
                android:textColor="#1F2937"
                android:textSize="32sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Tagline phụ màn đăng nhập -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Cứu hộ thiết bị và sửa chữa tận nơi"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Khung đăng nhập (Đã căn giữa tiêu đề bên trong) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_login_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Chào mừng trở lại!"
                android:textColor="#1E293B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Vui lòng đăng nhập để tiếp tục"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tài khoản"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:autofillHints="username"
                android:background="@drawable/bg_login_input"
                android:hint="Nhập email hoặc số điện thoại"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#1E293B"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Mật khẩu"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_login_input">

                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="password"
                    android:background="@android:color/transparent"
                    android:hint="Nhập mật khẩu"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="48dp"
                    android:singleLine="true"
                    android:textColor="#1E293B"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:clickable="true"
                    android:contentDescription="Hiển thị mật khẩu"
                    android:focusable="true"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_eye" />

            </FrameLayout>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#2563EB"
                android:text="Đăng nhập"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Điều hướng đăng ký -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có tài khoản? "
                android:textColor="#64748B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnGoRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="Đăng ký ngay"
                android:textColor="#2563EB"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>