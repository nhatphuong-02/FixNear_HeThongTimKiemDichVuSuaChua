<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151210"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="36dp"
        android:paddingBottom="30dp">

        <!-- TÊN THƯƠNG HIỆU -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fix"
                android:textColor="#D8975B"
                android:textSize="34sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Near"
                android:textColor="#FFF4EA"
                android:textSize="34sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Sửa chữa, lắp đặt, bảo trì gần bạn"
            android:textColor="#BCA99D"
            android:textSize="13sp"/>

        <!-- PHẦN CHÀO MỪNG -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:text="Chào mừng trở lại!"
            android:textColor="#FFF4EA"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Đăng nhập để tiếp tục với FixNear"
            android:textColor="#BCA99D"
            android:textSize="14sp"/>

        <!-- CARD ĐĂNG NHẬP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/fixnear_auth_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TÀI KHOẢN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tài khoản"
                android:textColor="#66442F"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/fixnear_auth_input"
                android:hint="Email hoặc số điện thoại"
                android:inputType="text"
                android:singleLine="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFF8F1"
                android:textColorHint="#B1A29A"
                android:textSize="14sp"
                android:autofillHints="username"/>

            <!-- MẬT KHẨU -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Mật khẩu"
                android:textColor="#66442F"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/fixnear_auth_input">

                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Nhập mật khẩu"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="54dp"
                    android:textColor="#FFF8F1"
                    android:textColorHint="#B1A29A"
                    android:textSize="14sp"
                    android:autofillHints="password"/>

                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:padding="14dp"
                    android:src="@drawable/ic_eye"
                    android:tint="#D9B9A1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Hiện hoặc ẩn mật khẩu"/>
            </FrameLayout>

            <!-- NÚT ĐĂNG NHẬP -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/fixnear_register_button"
                android:backgroundTint="@null"
                android:text="Đăng nhập"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"/>

        </LinearLayout>

        <!-- ĐĂNG KÝ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có tài khoản?"
                android:textColor="#BCA99D"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/btnGoRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="7dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Đăng ký ngay"
                android:textColor="#E0A16D"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
