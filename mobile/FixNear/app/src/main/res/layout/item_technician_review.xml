<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/card_cream"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_card"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- KHACH HANG VA NGAY DANH GIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTechnicianReviewCustomer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Khách hàng"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_card" />

            <TextView
                android:id="@+id/tvTechnicianReviewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="--/--/----"
                android:textSize="12sp"
                android:textColor="@color/text_secondary_card" />

        </LinearLayout>

        <!-- SO SAO -->
        <TextView
            android:id="@+id/tvTechnicianReviewStars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="☆☆☆☆☆"
            android:textSize="23sp"
            android:textColor="@color/accent_gold_dark" />

        <!-- NOI DUNG NHAN XET -->
        <TextView
            android:id="@+id/tvTechnicianReviewComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Khách hàng không để lại nhận xét."
            android:textSize="14sp"
            android:textColor="@color/text_primary_card" />

        <!-- ANH DANH GIA -->
        <ImageView
            android:id="@+id/imgTechnicianReview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="14dp"
            android:contentDescription="Ảnh đánh giá của khách hàng"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- SO ANH CON LAI -->
        <TextView
            android:id="@+id/tvTechnicianReviewImagesCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ảnh đính kèm"
            android:textSize="12sp"
            android:textColor="@color/accent_gold_dark"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
