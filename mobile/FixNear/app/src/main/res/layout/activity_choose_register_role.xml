<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151210"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">


        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="105dp"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="←  Quay lại"
            android:textColor="#E0A16D"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/fixnear_role_card"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Quay lại"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="FixNear"
            android:textColor="#D8975B"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Đăng ký với tư cách"
            android:textColor="#FFF4EA"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="25dp"
            android:text="Chọn loại tài khoản phù hợp để bắt đầu cùng FixNear."
            android:textColor="#C7B9AF"
            android:textSize="14sp"/>

        <LinearLayout
            android:id="@+id/btnCustomer"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:background="@drawable/fixnear_role_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:gravity="center"
                android:text="01"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#D8975B"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Khách hàng"
                    android:textColor="#FFF4EA"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Tìm và đặt dịch vụ sửa chữa"
                    android:textColor="#BBAA9E"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#D8975B"
                android:textSize="30sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnShop"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/fixnear_role_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:gravity="center"
                android:text="02"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#D8975B"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cửa hàng"
                    android:textColor="#FFF4EA"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Quản lý cửa hàng và dịch vụ"
                    android:textColor="#BBAA9E"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#D8975B"
                android:textSize="30sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnTechnician"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/fixnear_role_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:gravity="center"
                android:text="03"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#D8975B"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kỹ thuật viên"
                    android:textColor="#FFF4EA"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Nhận việc và thực hiện sửa chữa"
                    android:textColor="#BBAA9E"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#D8975B"
                android:textSize="30sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
