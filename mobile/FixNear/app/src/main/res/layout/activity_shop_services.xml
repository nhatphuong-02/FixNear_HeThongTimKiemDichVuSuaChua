<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#151210"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="@drawable/fixnear_role_card"
            android:text="‹"
            android:textColor="#FFF4EA"
            android:textSize="32sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="FixNear"
            android:textColor="#D8975B"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="48dp"
            android:layout_height="1dp"/>
    </LinearLayout>

    <!-- NỘI DUNG -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dịch vụ &amp; Bảng giá"
                android:textColor="#FFF4EA"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Quản lý dịch vụ sửa chữa và giá cung cấp tại cửa hàng."
                android:textColor="#B9A79B"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvShopInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Chưa chọn cửa hàng"
                android:textColor="#D8975B"
                android:textSize="13sp"/>

            <!-- TAB DỊCH VỤ / BẢNG GIÁ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:background="@drawable/fixnear_role_card"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabServices"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Dịch vụ"
                    android:textColor="#D8975B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tabPrices"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Bảng giá"
                    android:textColor="#C7B9AF"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- TRANG DỊCH VỤ -->
            <LinearLayout
                android:id="@+id/sectionServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Dịch vụ cửa hàng"
                    android:textColor="#FFF4EA"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Dịch vụ phải được chọn từ danh mục của hệ thống."
                    android:textColor="#B9A79B"
                    android:textSize="13sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/fixnear_manager_cream_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="30dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙"
                        android:textColor="#A5652B"
                        android:textSize="44sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Chưa tải danh sách dịch vụ"
                        android:textColor="#38251B"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Danh sách sẽ được đồng bộ từ API T04 sau khi backend hoàn thiện phân quyền."
                        android:textColor="#8B7160"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"/>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddService"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/fixnear_register_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="+ Thêm dịch vụ"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- TRANG BẢNG GIÁ -->
            <LinearLayout
                android:id="@+id/sectionPrices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Bảng giá dịch vụ"
                    android:textColor="#FFF4EA"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Quản lý giá hiện hành và lịch sử cập nhật giá."
                    android:textColor="#B9A79B"
                    android:textSize="13sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/fixnear_manager_cream_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="30dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₫"
                        android:textColor="#A5652B"
                        android:textSize="42sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Chưa tải bảng giá"
                        android:textColor="#38251B"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Giá hiện hành và lịch sử giá sẽ được lấy từ API T05."
                        android:textColor="#8B7160"
                        android:textSize="13sp"
                        android:gravity="center"/>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddPrice"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/fixnear_register_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="+ Thêm giá dịch vụ"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
