<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151210"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- Logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fix"
                android:textColor="#D8975B"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Near"
                android:textColor="#FFF4EA"
                android:textSize="24sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tạo tài khoản"
            android:textColor="#FFF4EA"
            android:textSize="27sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="42dp"
            android:layout_height="3dp"
            android:layout_marginTop="9dp"
            android:background="#D8975B"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tham gia FixNear để kết nối với dịch vụ sửa chữa gần bạn."
            android:textColor="#C5B6AA"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"/>

        <!-- Form đăng ký -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/fixnear_auth_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Họ tên -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Họ và tên"
                android:textColor="#66442F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fixnear_auth_input"
                android:hint="Nhập họ và tên"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#FFF8F1"
                android:textColorHint="#A99A91"
                android:textSize="14sp"
                android:autofillHints="name"/>

            <!-- Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Email"
                android:textColor="#66442F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fixnear_auth_input"
                android:hint="Nhập địa chỉ email"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#FFF8F1"
                android:textColorHint="#A99A91"
                android:textSize="14sp"
                android:autofillHints="emailAddress"/>

            <!-- Số điện thoại -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Số điện thoại"
                android:textColor="#66442F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fixnear_auth_input"
                android:hint="Nhập số điện thoại"
                android:inputType="phone"
                android:maxLength="10"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#FFF8F1"
                android:textColorHint="#A99A91"
                android:textSize="14sp"
                android:autofillHints="phone"/>

            <!-- Ngày sinh -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Ngày sinh"
                android:textColor="#66442F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtDateOfBirth"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fixnear_auth_input"
                android:hint="Chọn ngày sinh"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:drawableTint="#D8975B"
                android:drawablePadding="8dp"
                android:textColor="#FFF8F1"
                android:textColorHint="#A99A91"
                android:textSize="14sp"/>

            <!-- Giới tính -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Giới tính"
                android:textColor="#66442F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <RadioGroup
                android:id="@+id/radioGroupGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="24dp"
                    android:buttonTint="#C47D42"
                    android:text="Nam"
                    android:textColor="#493326"
                    android:textSize="14sp"/>

                <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:buttonTint="#C47D42"
                    android:text="Nữ"
                    android:textColor="#493326"
                    android:textSize="14sp"/>
            </RadioGroup>

            <!-- THÔNG TIN ĐỊA CHỈ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="ĐỊA CHỈ CỦA BẠN"
                android:textColor="#A36A43"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="16dp"
                android:background="#E7D8CA"/>

            <!-- Tỉnh / Thành phố -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tỉnh / Thành phố"
                android:textColor="#66442F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spProvince"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fixnear_auth_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:spinnerMode="dropdown"/>

            <!-- Phường / Xã -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Phường / Xã"
                android:textColor="#66442F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spWard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fixnear_auth_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:spinnerMode="dropdown"/>

            <!-- Địa chỉ chi tiết -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Địa chỉ chi tiết"
                android:textColor="#66442F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtAddressLine"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fixnear_auth_input"
                android:hint="Số nhà, tên đường, thôn/tổ..."
                android:inputType="textPostalAddress"
                android:maxLength="500"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#FFF8F1"
                android:textColorHint="#B5A59B"
                android:textSize="14sp"/>

            <!-- Mật khẩu -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mật khẩu"
                android:textColor="#66442F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fixnear_auth_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Nhập mật khẩu"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:padding="0dp"
                    android:textColor="#FFF8F1"
                    android:textColorHint="#A99A91"
                    android:textSize="14sp"
                    android:autofillHints="newPassword"/>

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_eye"
                    android:tint="#D9B9A1"
                    android:contentDescription="Hiện hoặc ẩn mật khẩu"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Xác nhận mật khẩu -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Xác nhận mật khẩu"
                android:textColor="#66442F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/fixnear_auth_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/edtConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Nhập lại mật khẩu"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:padding="0dp"
                    android:textColor="#FFF8F1"
                    android:textColorHint="#A99A91"
                    android:textSize="14sp"
                    android:autofillHints="newPassword"/>

                <ImageView
                    android:id="@+id/ivToggleConfirmPassword"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_eye"
                    android:tint="#D9B9A1"
                    android:contentDescription="Hiện hoặc ẩn xác nhận mật khẩu"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Nút đăng ký -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/fixnear_register_button"
                android:backgroundTint="@null"
                android:text="Đăng ký"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"/>

        </LinearLayout>

        <!-- Chuyển đăng nhập -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã có tài khoản?"
                android:textColor="#C7B9AF"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="Đăng nhập"
                android:textColor="#E0A16D"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
