<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Thương hiệu FIXNEAR đồng bộ style -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="FIX"
                android:textColor="#2563EB"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEAR"
                android:textColor="#1F2937"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Tiêu đề nhỏ gọn hơn -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Tạo tài khoản"
            android:textColor="#172033"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Tham gia FixNear để kết nối với dịch vụ sửa chữa gần bạn."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <!-- Nhóm biểu mẫu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_register_card"
            android:elevation="2dp">

            <!-- Họ và tên -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Họ và tên"
                android:textColor="#263449"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_register_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Nhập họ và tên"
                android:textColor="#111827"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textPersonName"
                android:autofillHints="name" />

            <!-- Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Email"
                android:textColor="#263449"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_register_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Nhập địa chỉ email"
                android:textColor="#111827"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress" />

            <!-- Số điện thoại -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Số điện thoại"
                android:textColor="#263449"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_register_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Nhập số điện thoại"
                android:textColor="#111827"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="phone"
                android:autofillHints="phone" />

            <!-- Ngày sinh -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ngày sinh"
                android:textColor="#263449"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtDateOfBirth"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_register_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Chọn ngày sinh"
                android:textColor="#111827"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:singleLine="true"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:drawableTint="#64748B" />

            <!-- Giới tính -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Giới tính"
                android:textColor="#263449"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="20dp"
                    android:buttonTint="#155EEF"
                    android:text="Nam"
                    android:textColor="#334155"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:buttonTint="#155EEF"
                    android:text="Nữ"
                    android:textColor="#334155"
                    android:textSize="14sp" />

            </RadioGroup>

            <!-- Mật khẩu -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mật khẩu"
                android:textColor="#263449"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_register_input"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:hint="Nhập mật khẩu"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_eye"
                    android:contentDescription="Hiển thị mật khẩu"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Xác nhận mật khẩu -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Xác nhận mật khẩu"
                android:textColor="#263449"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_register_input"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <EditText
                    android:id="@+id/edtConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:hint="Nhập lại mật khẩu"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword" />

                <ImageView
                    android:id="@+id/ivToggleConfirmPassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_eye"
                    android:contentDescription="Hiển thị mật khẩu"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Nút đăng ký -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#155EEF"
                android:text="Đăng ký"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- Chuyển đến đăng nhập -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã có tài khoản? "
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Đăng nhập"
                android:textColor="#155EEF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>