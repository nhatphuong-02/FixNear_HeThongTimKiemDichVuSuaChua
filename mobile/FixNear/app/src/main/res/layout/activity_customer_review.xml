<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#151210"
    android:fitsSystemWindows="true" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textColor="#FFF8F1" android:textSize="32sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Đánh giá dịch vụ" android:textColor="#D8975B" android:textSize="19sp" android:textStyle="bold" />
        <View android:layout_width="48dp" android:layout_height="1dp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminateTint="#D8975B" android:visibility="gone" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="18dp" android:paddingBottom="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đánh giá trải nghiệm sửa chữa" android:textColor="#FFF8F1" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Chọn đối tượng và số sao để đánh giá" android:textColor="#C7B9AF" android:textSize="13sp" />
            <RadioGroup android:id="@+id/rgType" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
                <RadioButton android:id="@+id/rbShop" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#D8975B" android:text="Đánh giá cửa hàng" android:checked="true" android:textColor="#FFF8F1" />
                <RadioButton android:id="@+id/rbTechnician" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#D8975B" android:text="Đánh giá kỹ thuật viên" android:textColor="#FFF8F1" />
            </RadioGroup>
            <TextView android:id="@+id/tvTechnician" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#C7B9AF" android:textSize="13sp" android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Mức độ hài lòng" android:textColor="#D8975B" android:textSize="16sp" android:textStyle="bold" />
            <RatingBar android:id="@+id/ratingBar" style="?android:attr/ratingBarStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:numStars="5" android:stepSize="1.0" android:rating="5" android:progressTint="#D8975B" android:secondaryProgressTint="#D8975B" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Nhận xét (không bắt buộc)" android:textColor="#D8975B" android:textSize="16sp" android:textStyle="bold" />
            <EditText android:id="@+id/edtComment" android:layout_width="match_parent" android:layout_height="130dp" android:layout_marginTop="10dp" android:padding="14dp" android:gravity="top|start" android:background="@drawable/fixnear_input_dark" android:textColor="#FFF8F1" android:textColorHint="#BCA99B" android:hint="Chia sẻ trải nghiệm của bạn..." android:inputType="textMultiLine" android:maxLength="2000" />
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/btnSubmit" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:backgroundTint="#D8975B" android:textColor="#1D150F" android:textStyle="bold" android:textAllCaps="false" android:text="Gửi đánh giá" />
</LinearLayout>
