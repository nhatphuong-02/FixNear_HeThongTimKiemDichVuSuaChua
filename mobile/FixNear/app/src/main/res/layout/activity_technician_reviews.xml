<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:padding="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBackReviews"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="32sp"
            android:textColor="@color/text_primary_dark"
            android:contentDescription="Quay lại"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Đánh giá của tôi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_dark" />

    </LinearLayout>

    <!-- TONG QUAN DANH GIA -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/card_cream"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Tổng quan đánh giá"
                android:textColor="@color/text_primary_card"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReviewAverage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="--/5"
                android:textColor="@color/accent_gold_dark"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReviewStars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Chưa có điểm đánh giá"
                android:textColor="@color/accent_gold_dark"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvReviewTotalCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="-- đánh giá"
                android:textColor="@color/text_secondary_card"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- DANH SACH -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="12dp"
        android:text="Nhận xét từ khách hàng"
        android:textColor="@color/text_primary_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- VUNG NOI DUNG VA TRANG THAI -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTechnicianReviews"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <!-- EMPTY / ERROR -->
        <LinearLayout
            android:id="@+id/layoutReviewsState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvReviewsStateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Đánh giá khách hàng"
                android:textColor="@color/text_primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReviewsStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Thông tin đánh giá sẽ hiển thị tại đây."
                android:textColor="@color/text_secondary_dark"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryReviews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Thử lại"
                android:textAllCaps="false"
                android:textColor="@color/text_primary_card"
                android:visibility="gone"
                app:backgroundTint="@color/accent_gold"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- LOADING -->
        <ProgressBar
            android:id="@+id/progressReviews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_gold"
            android:visibility="gone" />

    </FrameLayout>

    <!-- PHAN TRANG -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLoadMoreReviews"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Xem thêm đánh giá"
        android:textAllCaps="false"
        android:textColor="@color/text_primary_card"
        android:visibility="gone"
        app:backgroundTint="@color/card_cream"
        app:cornerRadius="14dp" />

    <ProgressBar
        android:id="@+id/progressMoreReviews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:indeterminateTint="@color/accent_gold"
        android:visibility="gone" />

</LinearLayout>
