<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <!-- HEADER: LOGO + ROLE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Tên ứng dụng -->
        <TextView
            android:id="@+id/tvHeaderAppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FixNear"
            android:textColor="@color/accent_gold"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Nhãn vai trò -->
        <TextView
            android:id="@+id/tvHeaderRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_role"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="KỸ THUẬT VIÊN"
            android:textColor="@color/accent_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

    </LinearLayout>

    <!-- GREETING -->
    <TextView
        android:id="@+id/tvHeaderGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Xin chào, Tiến!"
        android:textColor="@color/text_primary_dark"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- DESCRIPTION -->
    <TextView
        android:id="@+id/tvHeaderDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Chúc bạn có một ngày làm việc hiệu quả."
        android:textColor="@color/text_secondary_dark"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />

</LinearLayout>