<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".FixNearApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fixnear"
        android:usesCleartextTraffic="true">

        <!-- SPLASH -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Fixnear.Starting">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- AUTH -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.ChooseRegisterRoleActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.RoleRegisterActivity"
            android:exported="false" />

        <!-- HOME -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- TECHNICIAN UI01 - DANH SACH CONG VIEC -->
        <activity
            android:name=".ui.assignment.AssignmentActivity"
            android:exported="false" />

        <!-- TECHNICIAN UI02 - CHI TIET VA KHAO SAT -->
        <activity
            android:name=".ui.assignment.AssignmentDetailActivity"
            android:exported="false" />

        <!-- TECHNICIAN UI03 - TAO BAO GIA -->
        <activity
            android:name=".ui.quote.CreateQuoteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- TECHNICIAN UI04 - CHI TIET BAO GIA -->
        <activity
            android:name=".ui.quote.QuoteDetailActivity"
            android:exported="false" />

        <!-- TECHNICIAN UI05 - TIEN DO SUA CHUA -->
        <activity
            android:name=".ui.repair.RepairProgressActivity"
            android:exported="false" />

        <!-- CUSTOMER -->
        <activity
            android:name=".ui.home.CustomerRepairRequestsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.CustomerRepairDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.CustomerUpcomingSchedulesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.CreateRepairRequestActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.ShopDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.ShopReviewsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.NearbyShopsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.CustomerCatalogActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.CustomerQuoteDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.CustomerQuotesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.CustomerConversationsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.CustomerChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.home.CustomerNotificationsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.CustomerBillingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.CustomerReviewActivity"
            android:exported="false" />

        <!-- MANAGER -->
        <activity
            android:name=".ui.manager.ManagerHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.manager.ShopProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.manager.ShopMembersActivity"
            android:exported="false" />

        <activity
            android:name=".ui.manager.ShopServicesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.manager.ManagerRepairRequestsActivity"
            android:exported="false" />

    </application>

</manifest>
