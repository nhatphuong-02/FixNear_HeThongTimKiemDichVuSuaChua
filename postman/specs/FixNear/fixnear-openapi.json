  "components": {
    "schemas": {
      "AddServiceDto": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CompleteRepairDto": {
        "required": [
          "result"
        ],
        "type": "object",
        "properties": {
          "result": {
            "minLength": 1,
            "type": "string"
          },
          "workDescription": {
            "type": "string",
            "nullable": true
          },
          "recommendation": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateInvoiceDto": {
        "type": "object",
        "properties": {
          "repairRequestId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "quoteId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreatePaymentDto": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "paymentMethod": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateQuoteDetailDto": {
        "type": "object",
        "properties": {
          "itemType": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "serviceRefId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "repairItemRefId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "repairPartRefId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "format": "double"
          },
          "unitPrice": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateQuoteDto": {
        "required": [
          "details"
        ],
        "type": "object",
        "properties": {
          "repairRequestId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "details": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateQuoteDetailDto"
            }
          }
        },
        "additionalProperties": false
      },
      "CreateRepairItemDto": {
        "required": [
          "itemCode",
          "itemName"
        ],
        "type": "object",
        "properties": {
          "itemCode": {
            "minLength": 1,
            "type": "string"
          },
          "itemName": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "defaultPrice": {
            "maximum": 999999999999,
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateRepairPartUsageDto": {
        "type": "object",
        "properties": {
          "repairRequestId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "repairPartId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "maximum": 999999,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "note": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateReviewDto": {
        "type": "object",
        "properties": {
          "repairRequestId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "rating": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "comment": {
            "maxLength": 2000,
            "type": "string",
            "nullable": true
          },
          "technicianId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "imageUrls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
