# ============================================================
# FixNear - Global .gitignore
# Android Kotlin + ASP.NET Core C# + SQL Server
# ============================================================


# ============================================================
# GENERAL
# ============================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
*.log

# IDE files
*.iml


# ============================================================
# ANDROID / KOTLIN
# ============================================================

# Gradle
.gradle/
**/.gradle/

# Build output
build/
**/build/

# Android Studio
.idea/
**/.idea/

# Local configuration
local.properties

# Android generated files
captures/
.externalNativeBuild/
.cxx/

# Generated APK/AAB
*.apk
*.aab

# Android Studio generated files
output-metadata.json

# Kotlin
*.kotlin_module

# Native build
*.so


# ============================================================
# JAVA / GRADLE
# ============================================================

# Gradle wrapper generated files
.gradle/

# Java compiled files
*.class

# Package files
*.jar
*.war
*.ear


# ============================================================
# .NET / ASP.NET CORE / C#
# ============================================================

# Build folders
bin/
obj/

# Visual Studio cache
.vs/

# Rider
.idea/
*.sln.iml

# Visual Studio user-specific files
*.user
*.userosscache
*.suo
*.userprefs

# Visual Studio Code
.vscode/

# Test results
TestResults/
*.trx

# Code coverage
coverage/
*.coverage
*.coveragexml

# NuGet
packages/
*.nupkg
*.snupkg

# NuGet generated files
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET generated files
wwwroot/lib/

# Publish output
publish/
PublishProfiles/

# MSBuild logs
*.binlog

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/

# Dotnet user secrets
secrets.json


# ============================================================
# DATABASE / SQL SERVER
# ============================================================

# Local database files
*.mdf
*.ldf
*.ndf

# SQL Server backup files
*.bak

# Local DB files
*.db
*.sqlite
*.sqlite3

# Database local configuration
database/local/


# ============================================================
# ENVIRONMENT / SECRETS
# ============================================================

# Environment files
.env
.env.*
!.env.example

# ASP.NET local configuration
appsettings.Local.json
appsettings.local.json

# Development secrets
secrets.json

# Certificates / private keys
*.pfx
*.p12
*.key
*.pem

# JWT / API secrets
*.secret


# ============================================================
# USER-SPECIFIC CONFIGURATION
# ============================================================

# Local development configuration
local/
.local/

# Temporary development files
temp/
tmp/


# ============================================================
# DOCUMENTATION GENERATED FILES
# ============================================================

# Temporary office files
~$*.doc
~$*.docx
~$*.xls
~$*.xlsx
~$*.ppt
~$*.pptx

# Temporary PDF files
*.temp.pdf


# ============================================================
# NODE / NPM
# ============================================================
# Keep this in case frontend/web tooling is added later

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
.next/
.nuxt/


# ============================================================
# FILE UPLOADS / USER GENERATED DATA
# ============================================================

# Local uploaded files
uploads/
wwwroot/uploads/

# Local images generated during development
generated/


# ============================================================
# TEST / LOCAL DATA
# ============================================================

test-results/
coverage/


# ============================================================
# BACKUP
# ============================================================

*.orig
*.rej
*.old


# ============================================================
# IMPORTANT
# ============================================================
# DO NOT commit:
# - Passwords
# - API keys
# - JWT secrets
# - Database passwords
# - Private certificates
# - local.properties
# - appsettings.Local.json
# - .env files